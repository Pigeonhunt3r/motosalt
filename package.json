{
  "name": "motosalt",
  "version": "0.3.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@mapbox/vector-tile": "^2.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "fastify": "^5.12.7",
    "leaflet": "^1.9.4",
    "pbf": "^4.0.1",
    "proj4": "^2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pbf": "^3.0.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8081",
    "start:cloud": "expo start --offline --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint App.tsx src server scripts --ignore-pattern src/generated/**",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "export": "expo export --platform all --output-dir dist",
    "check": "npm run lint && npm run typecheck && npm run server:typecheck && npm test && npm run test:server && npm run server:build && npm run test:server:runtime && npm run export",
    "format": "prettier --write App.tsx src server scripts *.json *.ts *.cjs .github/workflows/*.yml",
    "format:check": "prettier --check App.tsx src server scripts *.json *.ts *.cjs .github/workflows/*.yml",
    "postinstall": "node scripts/build-map.mjs",
    "server": "tsx watch server/index.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "test:server": "tsx --test server/*.test.ts",
    "test:live": "tsx scripts/live-check.ts",
    "server:build": "tsc -p server/tsconfig.build.json",
    "server:start": "node server-dist/server/index.js",
    "test:stops": "tsx scripts/stops-check.ts",
    "test:coverage": "tsx scripts/coverage-check.ts",
    "test:server:runtime": "tsx scripts/server-smoke.ts",
    "test:winter": "tsx scripts/winter-check.ts",
    "android:apk": "python3 scripts/android-build.py"
  },
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
